bin
frontend/node_modules
# Generated by "wails3 generate bindings" at build time.
frontend/bindings
# Only the placeholder is tracked, so that "go:embed all:frontend/dist" compiles
# without an npm build.
frontend/dist/*
!frontend/dist/.gitkeep
build/linux/appimage/build
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
