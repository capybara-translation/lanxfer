# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
# .vscode/

tmp/

docs/superpowers

# Build output
/lanxfer
/lanxfer-*
dist/
.superpowers/brainstorm/
# GUI app (gui/ is a separate Go module; see gui/.gitignore for the rest).
# "dist/" above also matches the frontend build output, so re-include the
# folder and keep only the placeholder, which lets "go:embed all:frontend/dist"
# compile without an npm build.
!gui/frontend/dist/
gui/frontend/dist/*
!gui/frontend/dist/.gitkeep
gui/bin
gui/frontend/node_modules
gui/frontend/bindings
